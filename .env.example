# Copy this file to .env (scripts/install.sh does it for you) and fill it in.
# .env stays only on your server: never commit it, never paste it into a chat.

# mobileproxy.space API token (personal cabinet -> API).
MOBILEPROXY_API_TOKEN=

# Any other proxy instead: http://login:password@host:port, http://host:port or socks5://host:port.
# A proxy without a login must be reachable only over localhost or a private network (a warning is printed otherwise).
# If set, it is used instead of the token above.
# HIB_PROXY_URL=http://login:password@host:port
# With HIB_PROXY_URL the address is used as it is: choose a sticky session at your provider yourself.

# Optional settings (all unset by default):
# Where browser profiles live (default ~/.local/share/hib/profiles). Never inside the repository.
# HIB_PROFILES_DIR=/path/to/profiles
# Minimal seconds between two navigations to one host in one profile (default 20, minimum 5).
# HIB_MIN_GAP_S=20
# mobileproxy.space only: wanted exit state and city (the values the service accepts are not verified).
# HIB_PROXY_STATE=
# HIB_PROXY_CITY=
# mobileproxy.space only: proxy id, if the first proxy of the account is not the residential one.
# HIB_PROXY_ID=
